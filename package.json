{
  "name": "@ubuntupunk/suckless-pi",
  "version": "0.1.0",
  "description": "Curated, audited, and suckless extensions for Pi",
  "main": "index.js",
  "keywords": [
    "pi-package"
  ],
  "author": "ubuntupunk",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "packages/manager/index.ts"
    ],
    "manager": {
      "enabled": true,
      "config": ".pi/",
      "userConfig": "~/.pi/"
    },
    "skills": [
      "skills/"
    ],
    "prompts": [
      "prompts/"
    ],
    "themes": [
      ".pi/themes/"
    ]
  },
  "dependencies": {
    "@aliou/pi-agent-kit": "*",
    "@aliou/pi-linkup": "^0.7.1",
    "@aliou/pi-utils-settings": "*",
    "@aliou/pi-utils-ui": "*",
    "@aliou/sesame": "^0.4.0",
    "@aliou/sh": "^0.1.0",
    "@mariozechner/pi-ai": "*",
    "@mozilla/readability": "^0.5.0",
    "@sinclair/typebox": "^0.34.41",
    "better-sqlite3": "^12.6.2",
    "jsdom": "^26.0.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.20.5",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  }
}
